{
  "name": "bcentral-app",
  "private": true,
  "version": "0.0.1",
  "description": "BCentral staff app: offline-first PWA for a MeshCore communication desk with a journal",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/make-icon.mjs",
    "dev": "vite",
    "prebuild": "node scripts/make-icon.mjs",
    "build": "vite build",
    "preview": "vite preview --open /twinoak.bcentral/",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/check-contrast.mjs && vitest run",
    "screenshots": "node scripts/screenshots.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.0",
    "ulid": "^2.3.0 || ^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
